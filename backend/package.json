{
  "name": "organic-powder-server",
  "version": "1.0.0",
  "description": "Backend API for the Organic Powder platform",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --runInBand",
    "test:unit": "jest tests/unit --runInBand",
    "test:integration": "jest tests/integration --runInBand",
    "test:providers": "jest tests/providers --runInBand",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.js\"",
    "seed": "node src/scripts/seed.js",
    "bootstrap:owner": "node src/scripts/bootstrapOwner.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "mongoose": "^9.10.2",
    "multer": "^2.5.0",
    "nodemailer": "^10.6.1"
  },
  "devDependencies": {
    "eslint": "^10.15.0",
    "jest": "^30.5.2",
    "js-yaml": "^5.5.0",
    "mongodb-memory-server": "^11.4.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2"
  }
}
